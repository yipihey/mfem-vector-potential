+    void ComputeBDiag(ParGridFunction &B, ParFiniteElementSpace &fes_div, BDiag &d)
+    {
+        ParFiniteElementSpace *fes_B = B.ParFESpace();
+        MPI_Comm comm = fes_B->GetParMesh()->GetComm();
+        real_t BB = GFInnerProduct(B, B);
+        d.EB = 0.5 * BB;
+        d.normB = std::sqrt(std::max(BB, (real_t)0.0));
+        d.divL2 = GFDivError(B);
+
+        ParDiscreteLinearOperator div(fes_B, &fes_div);
+        div.AddDomainInterpolator(new DivergenceInterpolator);
+        div.Assemble();
+        div.Finalize();
+        ParGridFunction divgf(&fes_div);
+        div.Mult(B, divgf);
+        ConstantCoefficient zero(0.0);
+        d.divFn = divgf.ComputeL2Error(zero);
+        real_t mx = divgf.Normlinf();
+        MPI_Allreduce(MPI_IN_PLACE, &mx, 1, MPITypeMap<real_t>::mpi_type, MPI_MAX, comm);
+        d.divMax = mx;
+    }
+
+    real_t GFL2Diff(const ParGridFunction &a, const ParGridFunction &b)
+    {
+        ParGridFunction diff(a);
+        diff -= b;
+        real_t nn = GFInnerProduct(diff, diff);
+        return std::sqrt(std::max(nn, (real_t)0.0));
+    }
