+// ---- instrumentation (E6 diagnostics) ----
+// Diagnostics of an RT magnetic-flux grid function B.
+struct BDiag
+{
+    real_t EB;      // 0.5 * int B.B   (raw, i.e. without 1/mu)
+    real_t normB;   // L2 norm of B
+    real_t divL2;   // L2 norm of div B (GFDivError, evaluated at quadrature points)
+    real_t divFn;   // L2 norm of the L2-function DivergenceInterpolator(B)
+    real_t divMax;  // max |dof| of DivergenceInterpolator(B)
+};
+void ComputeBDiag(ParGridFunction &B, ParFiniteElementSpace &fes_div, BDiag &d);
+
+// L2 norm of (a - b) for two grid functions in the same space
+real_t GFL2Diff(const ParGridFunction &a, const ParGridFunction &b);
